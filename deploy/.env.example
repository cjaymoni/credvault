# Copy to .env and fill in. .env holds the registration token: keep it 0600
# and out of version control.

# Domain with an A/AAAA record pointing at this VPS. Caddy gets a certificate
# for it automatically on first start.
KLAVYN_DOMAIN=vault.example.com

# Domain for the marketing site, served as static files by the same Caddy.
# Caddy answers on this name and on www.<name>, redirecting www here, and gets
# a certificate for both -- so both need A/AAAA records pointing at this VPS
# before you start, or the certificate for them fails.
KLAVYN_SITE_DOMAIN=example.com

# Address Let's Encrypt uses for expiry notices.
KLAVYN_ACME_EMAIL=you@example.com

# Who may create an account. Read this one before you deploy: as it ships,
# blank, ANYONE who can reach this server can create an account on it.
#
# Set a token to limit it to people you give the token to. Generate one with:
#   openssl rand -base64 32
# Share it only with those people; rotate by changing it here and restarting
# (existing accounts are unaffected).
#
# To allow nobody at all, leave this blank and set KLAVYN_CLOSED_REGISTRATION
# below instead. Setting both stops the server rather than guessing.
KLAVYN_REGISTRATION_TOKEN=

# Set to true to refuse all new accounts. Leave blank otherwise; blank here
# does not mean "closed", it means this setting is not in use -- and so do
# false and 0. true, yes, on and 1 all close registration, in any
# capitalisation. Anything else stops the server rather than being guessed at,
# including off and no: on a variable called CLOSED_REGISTRATION those read
# both ways, and the wrong reading is a server open to anyone.
KLAVYN_CLOSED_REGISTRATION=

# info, debug, or e.g. klavyn_server=debug,tower_http=debug
RUST_LOG=info

# ----- sign in with Google (optional) ---------------------------------------
# Leave both blank to keep the server password-only. Create an OAuth client of
# type "Desktop app" in the Google Cloud console; that type is required,
# because the app listens on whatever loopback port the OS gives it.
#
# Google replaces the login credential only. Users still enter a passphrase,
# which is what derives the vault key, so enabling this does not weaken the
# encryption — but anyone who takes over a linked Google account can reach the
# server as that user and see secret names, the sharing graph and ciphertext.
KLAVYN_GOOGLE_CLIENT_ID=
KLAVYN_GOOGLE_CLIENT_SECRET=

# ----- counting installations (optional) ------------------------------------
# Blank, which is the default, means the server makes no outbound analytics
# request at all and counts nothing.
#
# With a key set, the server sends one event each time an app asks it what it
# supports — which happens on startup, before the sign-in screen and so before
# there is an account to attribute it to. Each event carries the operating
# system, the app version, the country, and an id derived from the client
# address, the build, the day and a random salt. The address is used to
# compute that id and then dropped: it is not stored and not sent. The salt is
# held only in memory and is overwritten with fresh bytes at midnight UTC, by
# a timer rather than by the next request, so it counts installations for one
# day and nobody -- including you, on this machine -- can recompute
# yesterday's. A restart also starts a fresh one.
#
# Country comes from CF-IPCountry, and is only believed when the server is
# running with --trust-forwarded-for, because without a proxy in front that
# header is whatever the client typed. This compose file already sets that
# flag, since Caddy sits in front of the server — it is deliberately not a
# setting here, so there is nothing for you to do. The server warns at startup
# if it ever finds itself counting without it.
#
# This is a PostHog *project* key (phc_...), which is designed to be public,
# not a personal API key. Setting it changes what your privacy policy has to
# say — docs/privacy.md already describes this feature, but it names an
# operator and a retention period you must fill in.
KLAVYN_POSTHOG_API_KEY=

# Blank uses PostHog's EU cloud. Set to https://us.i.posthog.com for the US
# region, or to your own address for a self-hosted PostHog.
KLAVYN_POSTHOG_HOST=
