{
	email {$KLAVYN_ACME_EMAIL}
}

# The API. Nothing but /api and /health belongs here, so everything else is
# refused at the proxy rather than reaching the application.
{$KLAVYN_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@api path /api /api/* /health
	handle @api {
		reverse_proxy klavyn:8787
	}

	handle {
		respond "not found" 404
	}
}

# The marketing site: static files from ./site, mounted read-only into this
# container. Separate names rather than paths under the API domain, so adding
# a page here can never collide with an API route.
#
# No Referrer-Policy: unlike the API, this is a public site where referrers
# are wanted. HSTS still applies -- note includeSubDomains on the apex covers
# the API subdomain too, which is intended, both are HTTPS-only.
{$KLAVYN_SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}

	root * /srv/site
	file_server
}

# One canonical name for the site. www exists because people type it; it is a
# permanent redirect rather than a second copy of the site.
www.{$KLAVYN_SITE_DOMAIN} {
	redir https://{$KLAVYN_SITE_DOMAIN}{uri} permanent
}
