# Copy to .env and fill in. .env holds the registration token: keep it 0600
# and out of version control.

# Domain with an A/AAAA record pointing at this VPS. Caddy gets a certificate
# for it automatically on first start.
CREDVAULT_DOMAIN=vault.example.com

# Address Let's Encrypt uses for expiry notices.
CREDVAULT_ACME_EMAIL=you@example.com

# Who may create an account. Read this one before you deploy: as it ships,
# blank, ANYONE who can reach this server can create an account on it.
#
# Set a token to limit it to people you give the token to. Generate one with:
#   openssl rand -base64 32
# Share it only with those people; rotate by changing it here and restarting
# (existing accounts are unaffected).
#
# To allow nobody at all, leave this blank and set CREDVAULT_CLOSED_REGISTRATION
# below instead. Setting both stops the server rather than guessing.
CREDVAULT_REGISTRATION_TOKEN=

# Set to true to refuse all new accounts. Leave blank otherwise; blank here
# does not mean "closed", it means this setting is not in use -- and so do
# false and 0. true, yes, on and 1 all close registration, in any
# capitalisation. Anything else stops the server rather than being guessed at,
# including off and no: on a variable called CLOSED_REGISTRATION those read
# both ways, and the wrong reading is a server open to anyone.
CREDVAULT_CLOSED_REGISTRATION=

# info, debug, or e.g. credvault_server=debug,tower_http=debug
RUST_LOG=info

# ----- sign in with Google (optional) ---------------------------------------
# Leave both blank to keep the server password-only. Create an OAuth client of
# type "Desktop app" in the Google Cloud console; that type is required,
# because the app listens on whatever loopback port the OS gives it.
#
# Google replaces the login credential only. Users still enter a passphrase,
# which is what derives the vault key, so enabling this does not weaken the
# encryption — but anyone who takes over a linked Google account can reach the
# server as that user and see secret names, the sharing graph and ciphertext.
CREDVAULT_GOOGLE_CLIENT_ID=
CREDVAULT_GOOGLE_CLIENT_SECRET=
