{
	email {$KLAVYN_ACME_EMAIL}
}

# The API. Nothing but /api and /health belongs here, so everything else is
# refused at the proxy rather than reaching the application.
{$KLAVYN_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@api path /api /api/* /health
	handle @api {
		reverse_proxy klavyn:8787 {
			# Behind Cloudflare, Caddy's peer is a Cloudflare edge, so the
			# address it would append to X-Forwarded-For is the edge's, not
			# the caller's. The server takes the rightmost entry as the one
			# its own proxy wrote (see ratelimit::client_ip), so without this
			# every request from everyone behind one edge rate-limits as a
			# single address -- one password guesser spends the whole budget
			# for that edge, and rotating edges buys more of it. The same
			# address feeds the installation count, which would become one
			# per edge per day instead of one per installation.
			#
			# Replacing the header rather than adding to it: the server reads
			# one entry and this is the only one worth reading.
			#
			# SAFE ONLY WHILE NOTHING BUT CLOUDFLARE CAN REACH THIS HOST.
			# CF-Connecting-IP is an ordinary header to anyone connecting
			# directly, so a reachable origin means a forgeable client
			# address, and with it someone else's rate-limit budget. The
			# firewall is what makes this true -- deploy/cloudflare-origin.sh,
			# and "Putting Cloudflare in front" in README.md.
			header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
		}
	}

	handle {
		respond "not found" 404
	}
}

# The marketing site: static files from ./site, mounted read-only into this
# container. Separate names rather than paths under the API domain, so adding
# a page here can never collide with an API route.
#
# No Referrer-Policy: unlike the API, this is a public site where referrers
# are wanted. HSTS still applies -- note includeSubDomains on the apex covers
# the API subdomain too, which is intended, both are HTTPS-only.
{$KLAVYN_SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}

	root * /srv/site
	file_server
}

# One canonical name for the site. www exists because people type it; it is a
# permanent redirect rather than a second copy of the site.
www.{$KLAVYN_SITE_DOMAIN} {
	redir https://{$KLAVYN_SITE_DOMAIN}{uri} permanent
}
